# Normalize line endings. Shell scripts MUST stay LF or Git Bash fails with "$'\r': command not found".
* text=auto
*.sh   text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.toml text eol=lf
Makefile text eol=lf
.importlinter text eol=lf
.gitleaks.toml text eol=lf
*.pdf  binary
*.png  binary
*.jpg  binary
*.zip  binary
